--Find categories where the total product sales are higher than 
--the average category sales across all categories.

with cte as 
(
select 
      sum(o.sales) as totalsales,
      p.category
 from orders as o
 left join products as p
 on o.productid = p.productid
 group by p.category
 )
 select * from
 (
 select 
       *,
       avg(totalsales)over() as avgcategory
       from cte
       )t
       where totalsales > avgcategory
