--Find products whose maximum single order quantity is higher than the average
---maximum order quantity within their category.

with cte 
as
(
select 
       p.category,
       o.productid,
       max(o.quantity) as totalquantity
       from orders as o
       left join products as p
       on o.productid = p.productid
       group by o.productid,p.category
       )
       select * from
       (
       select *,
              avg(totalquantity)over(partition by category) as avgtotalquantity
              from cte)t
              where totalquantity > avgtotalquantity

