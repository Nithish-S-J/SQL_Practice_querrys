---Find categories where the average sales of the Top 3 products (by total revenue)
---is greater than the company-wide --average sales of category Top 3 products.

with cte1 as
(
select p.category,
       o.productid,
       sum(o.sales) as totalsales,
       row_number() over(partition by p.category order by sum(o.sales)) as rn
       from orders as o
       left join products as p
       on o.productid = p.productid
       group by o.productid,p.category
       )
        , cte2 as
       (
       select category,
              avg(totalsales) as avgtotalsales
              from cte1
              where rn <=3
              group by category
              )
              select * from 
              ( select *,
                       avg(avgtotalsales) over () as top3avgsales
                       from cte2)t
                       where avgtotalsales > top3avgsales
                         
   

