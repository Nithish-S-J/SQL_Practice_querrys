--------------------------------------#1 find the total sales per customer -----------------------

with CTE_total_sales as
(
select 
     customerid,
     sum(sales) as totalsales,
     avg(sum(sales)) over() as avgtotalsales
     from orders
group by customerid
)

------------------------------step 2 find the last orderdate for each customer------------------------------

, cte_last_order as
(select customerid,
        max(orderdate) as lastorder 
        from orders
        group by customerid)

-------------------------------main_query------------------------------------------------------------------

select 
      id,
      concat(c.firstname,' ', c.lastname) as customername,
      cts.totalsales,
      cts.avgtotalsales,
      clo.lastorder
     from customers as c
left join CTE_total_sales as cts
on cts.customerid = c.id
left join cte_last_order as clo
on clo.customerid = c.id 

